{
  "name": "dsh-completion-chime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reply-finished chime and toast for the DSH web GUI",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3470437923-cloud/dsh-completion-chime.git"
  },
  "homepage": "https://github.com/3470437923-cloud/dsh-completion-chime#readme",
  "bugs": {
    "url": "https://github.com/3470437923-cloud/dsh-completion-chime/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "sound",
    "chime",
    "cordis"
  ]
}
